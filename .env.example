# ─── Postgres (auto-injected by Vercel/Neon integration in production) ───
# Set this locally to your Neon connection string for `drizzle-kit push`.
DATABASE_URL=

# ─── Crawler ───
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` to /api/crawl/dispatch.
# Set this to a long random string in Vercel env vars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ─── Billing (Stripe) ───
# Test-mode keys during development. Swap to live keys (sk_live_…) only
# when ready to take real payments. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret. Set after registering the endpoint at
# https://dashboard.stripe.com/test/webhooks. Required for /api/billing/webhook
# to accept incoming events. Locally, run `stripe listen` and use the
# whsec_… it prints — that's a separate secret from the production one.
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard (test mode). One per paid plan tier.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Overage pack SKU on the Pro tier. £15 / 100 products / month.
# Pro subscribers can stack 0–50 packs (i.e. up to +5,000 products on
# top of the base 400). Charged immediately on quantity change, prorated
# to the remainder of the current billing cycle.
STRIPE_PRICE_PRO_OVERAGE=

# ─── Owner override ───
# When set, the user with this UUID gets the 'owner' plan regardless of
# subscription state — used by the founder account to bypass billing in
# every environment. Look the UUID up after the first sign-in via
# `SELECT id FROM users WHERE email = 'you@example.com'`.
OWNER_USER_ID=

# ─── Admin bootstrap ───
# Comma-separated list of user UUIDs granted admin access in addition to
# whoever has users.is_admin = true in the DB. Use this to bootstrap
# admin access on a fresh environment, then flip the column for
# permanent admins. Empty / unset = no env-based admins.
ADMIN_USER_IDS=

# ─── Email (Resend) ───
# Required for magic-link sign-in emails AND alert/digest sending. The
# dispatch system silently skips alerts if these aren't set.
RESEND_API_KEY=
# The 'From' address — must be from a domain verified in your Resend account.
RESEND_FROM=alerts@rivlr.app
